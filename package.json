{
  "name": "@miorin/dsh-sideby-note",
  "version": "0.1.1",
  "type": "module",
  "description": "Sideby Note (边记部) — asynchronously draft your ideas while the agent is working: a lightweight workspace notes panel with a global view for the DeepSeek Harness Web GUI. Based and inspired by dsh-aside-note.",
  "license": "MIT",
  "author": "Rayle8",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miorin-chan/dsh-sideby-note.git"
  },
  "homepage": "https://github.com/miorin-chan/dsh-sideby-note#readme",
  "bugs": {
    "url": "https://github.com/miorin-chan/dsh-sideby-note/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "notes",
    "session-notes",
    "todo",
    "productivity"
  ],
  "engines": {
    "node": "^22.18.0 || >=24.11.0",
    "dsh": ">=0.2.2-rc.5"
  },
  "main": "index.js",
  "bin": {
    "dsh-sideby-note": "scripts/install.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "host/*.js",
    "host/attachment-metadata.ts",
    "host/attachment-route.ts",
    "host/workspace-migration.ts",
    "client/client.js",
    "scripts/install.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/assets",
    "docs/panel-ui-rules.md",
    "docs/README.md",
    "README.md",
    "README.en.md",
    "AGENTS.md",
    "AGENTS.local.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build:tools": "tsc -p tsconfig.tools.json",
    "build": "npm run build:tools && npm run build:host && npm run build:install && node scripts/build.mjs",
    "build:host": "tsc -p tsconfig.host.json",
    "build:install": "tsc -p tsconfig.install.json && node --input-type=module -e \"import { chmodSync } from 'node:fs'; chmodSync('scripts/install.mjs', 0o755)\"",
    "prepare": "npm run build 1>&2",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.install.json --noEmit && tsc -p tsconfig.tools.json --noEmit && tsc -p tsconfig.catalog.json --noEmit",
    "test": "npm run build && node --test \"tests/*.test.mts\"",
    "check": "npm run build:tools && npm run typecheck && npm test && node scripts/build.mjs --check && node scripts/sync-types.mjs --check && npm run catalog:check",
    "catalog:check": "node tools/catalog/check.mts",
    "design:review": "node tools/catalog/review.mts",
    "test:run": "npm run build && node tools/catalog/run.mts",
    "test:strict": "npm run build && node tools/catalog/run.mts --strict",
    "test:mutate": "node tools/catalog/mutate.mts"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.5",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.2-rc.5",
    "@deepseek-ai/dsh-app-boot": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-shortcuts": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-file-drag": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.2-rc.5",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.5",
    "@deepseek-ai/dsh-plugin-manager": "0.2.2-rc.5",
    "@deepseek-ai/dsh-storage": "0.2.2-rc.5",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.5",
    "@deepseek-ai/dsh-workspace": "0.2.2-rc.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "~18.3.31",
    "@types/react-dom": "~18.3.7",
    "esbuild": "0.28.2",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "~18.3.1",
    "typescript": "~5.7.3",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
