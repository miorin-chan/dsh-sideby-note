{
  "name": "dsh-sideby-note",
  "version": "0.1.0",
  "type": "module",
  "description": "Sideby Note (边记部) — asynchronously draft your ideas while the agent is working: a lightweight per-session notes button and right-side panel for the DeepSeek Harness Web GUI. Based and inspired by dsh-aside-note.",
  "license": "MIT",
  "author": "Rayle8",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LighghtEeloo/dsh-sideby-note.git"
  },
  "homepage": "https://github.com/LighghtEeloo/dsh-sideby-note#readme",
  "bugs": {
    "url": "https://github.com/LighghtEeloo/dsh-sideby-note/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "notes",
    "session-notes",
    "todo",
    "productivity"
  ],
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "main": "index.js",
  "bin": {
    "dsh-sideby-note": "scripts/install.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "host",
    "client/client.js",
    "scripts/install.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/assets",
    "docs/panel-ui-rules.md",
    "docs/README.md",
    "README.md",
    "README.en.md",
    "AGENTS.md",
    "AGENTS.local.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "npm run build:host && tsdown",
    "build:host": "tsdown --config tsdown.host.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.host.json",
    "lint": "oxlint src host/*.ts",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run lint && npm run typecheck && npm run build && npm test && npm run catalog:check",
    "release": "node tools/release.mjs",
    "prepack": "npm run build",
    "catalog:check": "node tools/catalog/check.mjs",
    "design:review": "node tools/catalog/review.mjs",
    "test:run": "node tools/catalog/run.mjs",
    "test:strict": "node tools/catalog/run.mjs --strict",
    "test:mutate": "node tools/catalog/mutate.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-shortcuts": "0.2.2-rc.5",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "~18.3.31",
    "@types/react-dom": "~18.3.7",
    "jsdom": "^29.1.1",
    "oxlint": "^1.90.0",
    "react": "^18.3.1",
    "react-dom": "~18.3.1",
    "tsdown": "^0.23.4",
    "typescript": "~5.7.3",
    "vitest": "^4.1.12",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
